generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  fullName     String
  email        String   @unique
  passwordHash String
  role         String   @default("admin")
  createdAt    DateTime @default(now())

  @@map("users")
}

model PracticeArea {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  description String?
  headline    String?
  createdAt   DateTime @default(now())

  attorneys            Attorney[]             @relation("AttorneyPracticeAreas")
  articles             Article[]
  consultationRequests ConsultationRequest[]

  @@map("practice_areas")
}

model Attorney {
  id           Int      @id @default(autoincrement())
  fullName     String
  title        String?
  photoUrl     String?
  bio          String?
  education    String?
  barAdmission String?
  email        String?
  createdAt    DateTime @default(now())

  practiceAreas PracticeArea[] @relation("AttorneyPracticeAreas")
  articles      Article[]

  @@map("attorneys")
}

model Article {
  id             Int       @id @default(autoincrement())
  title          String
  slug           String    @unique
  summary        String?
  content        String
  status         String    @default("draft")
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())

  author         Attorney      @relation(fields: [authorId], references: [id])
  authorId       Int
  practiceArea   PracticeArea? @relation(fields: [practiceAreaId], references: [id])
  practiceAreaId Int?

  @@map("articles")
}

model Faq {
  id         Int    @id @default(autoincrement())
  question   String
  answer     String
  orderIndex Int    @default(0)

  @@map("faqs")
}

model ConsultationRequest {
  id                     Int      @id @default(autoincrement())
  fullName               String
  phone                  String
  email                  String
  organization           String?
  preferredContactMethod String?
  message                String
  status                 String   @default("new")
  createdAt              DateTime @default(now())

  practiceArea   PracticeArea @relation(fields: [practiceAreaId], references: [id])
  practiceAreaId Int

  @@map("consultation_requests")
}

model ContactInquiry {
  id        Int      @id @default(autoincrement())
  fullName  String
  email     String
  phone     String?
  subject   String
  message   String
  createdAt DateTime @default(now())

  @@map("contact_inquiries")
}
